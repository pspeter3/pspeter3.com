{
  "name": "pspeter3.com",
  "description": "Personal website",
  "private": true,
  "scripts": {
    "start": "astro dev",
    "build": "astro build",
    "format": "prettier . --write --cache --cache-strategy content",
    "format:check": "prettier . --check --cache --cache-strategy content",
    "lint": "eslint . --cache --cache-strategy content --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "astro check",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "fix": "npm run lint:fix && npm run format"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pspeter3/pspeter3.com.git"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/rss": "^4.0.19",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/styles/global.css",
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
