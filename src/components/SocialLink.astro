---
import Icon, { type IconName } from "./Icon.astro";
interface Props {
  href: string;
  label: string;
  icon: IconName;
}
const { href, label, icon } = Astro.props;
---

<a
  href={href}
  class="flex h-12 w-12 items-center justify-center rounded-2xl text-gray-400 hover:text-sky-400 focus:outline-hidden focus:ring-3 focus:ring-sky-400 dark:text-gray-500 dark:hover:text-sky-500 dark:focus:ring-sky-500"
  aria-label={label}
>
  <Icon name={icon} />
</a>
